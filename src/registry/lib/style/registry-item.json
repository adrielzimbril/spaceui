{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "lib-style",
  "type": "registry:style",
  "title": "Style",
  "description": "Complete Space UI theme: colors, sidebar, fonts, and base styles. Use with `npx shadcn init @spaceui/lib-style` for full project setup.",
  "dependencies": [
    "@base-ui/react",
    "class-variance-authority",
    "lucide-react"
  ],
  "devDependencies": [
    "tw-animate-css"
  ],
  "cssVars": {
    "dark": {
      "background": "var(--color-zinc-950)",
      "foreground": "var(--color-white)",
      "muted": "hsl(0deg 0% 10.2%)",
      "muted-foreground": "var(--color-zinc-400)",
      "card": "var(--color-zinc-950)",
      "card-foreground": "var(--color-zinc-50)",
      "border": "--alpha(var(--color-white) / 8%)",
      "pill-active-bg": "--alpha(var(--color-white) / 14%)",
      "popover": "var(--color-zinc-950)",
      "popover-foreground": "var(--color-zinc-50)",
      "primary": "var(--color-zinc-50)",
      "primary-foreground": "var(--color-zinc-950)",
      "secondary": "var(--color-zinc-800)",
      "secondary-foreground": "var(--color-zinc-50)",
      "accent": "var(--color-zinc-800)",
      "accent-foreground": "var(--color-zinc-50)",
      "input": "--alpha(var(--color-white) / 10%)",
      "ring": "transparent",
      "info": "var(--color-blue-100)",
      "info-foreground": "var(--color-blue-800)",
      "success": "var(--color-emerald-100)",
      "success-foreground": "var(--color-emerald-800)",
      "warning": "var(--color-amber-100)",
      "warning-foreground": "var(--color-amber-800)",
      "error": "var(--color-red-100)",
      "error-foreground": "var(--color-red-800)",
      "destructive": "var(--color-red-800)",
      "destructive-foreground": "var(--color-red-400)",
      "chart-1": "var(--color-blue-700)",
      "chart-2": "var(--color-emerald-500)",
      "chart-3": "var(--color-amber-500)",
      "chart-4": "var(--color-purple-500)",
      "chart-5": "var(--color-rose-500)"
    },
    "light": {
      "background": "var(--color-white)",
      "foreground": "var(--color-zinc-950)",
      "muted": "var(--color-zinc-100)",
      "muted-foreground": "var(--color-zinc-600)",
      "card": "var(--color-white)",
      "card-foreground": "var(--color-zinc-950)",
      "border": "--alpha(var(--color-black) / 8%)",
      "pill-active-bg": "--alpha(var(--color-black) / 10%)",
      "popover": "var(--color-white)",
      "popover-foreground": "var(--color-zinc-950)",
      "primary": "var(--color-zinc-950)",
      "primary-foreground": "var(--color-white)",
      "secondary": "var(--color-zinc-100)",
      "secondary-foreground": "var(--color-zinc-700)",
      "accent": "var(--color-zinc-100)",
      "accent-foreground": "var(--color-zinc-950)",
      "input": "--alpha(var(--color-black) / 8%)",
      "ring": "transparent",
      "info": "var(--color-blue-100)",
      "info-foreground": "var(--color-blue-900)",
      "success": "var(--color-emerald-100)",
      "success-foreground": "var(--color-emerald-900)",
      "warning": "var(--color-amber-100)",
      "warning-foreground": "var(--color-amber-900)",
      "error": "var(--color-red-100)",
      "error-foreground": "var(--color-red-900)",
      "destructive": "var(--color-red-500)",
      "destructive-foreground": "var(--color-red-500)",
      "chart-1": "var(--color-orange-600)",
      "chart-2": "var(--color-teal-600)",
      "chart-3": "var(--color-cyan-900)",
      "chart-4": "var(--color-amber-400)",
      "chart-5": "var(--color-amber-500)"
    },
    "theme": {
      "font-sans": "var(--font-sans, ui-sans-serif, system-ui, sans-serif)",
      "font-mono": "var(--font-mono, ui-monospace, monospace)",
      "font-heading": "var(--font-sans, ui-sans-serif, system-ui, sans-serif)"
    }
  },
  "categories": [
    "style"
  ],
  "files": [],
  "createdAt": "2026-08-21",
  "updatedAt": "2026-08-21"
}
