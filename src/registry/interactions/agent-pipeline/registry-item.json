{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "interactions-agent-pipeline",
  "type": "registry:component",
  "title": "Agent Pipeline",
  "description": "An interactive multi-agent pipeline visualization with real-time physics, event logs, and playback controls.",
  "isPro": true,
  "dependencies": ["motion", "@keyline-icons/react", "@usespaceui/squishmoji", "@usespaceui/sounds"],
  "registryDependencies": [
    "https://www.spaceui.one/r/lib-utils.json",
    "https://www.spaceui.one/r/components-spaceui-badge-squircle.json",
    "https://www.spaceui.one/r/primitives-scroll-area.json",
    "https://www.spaceui.one/r/primitives-frame.json",
    "https://www.spaceui.one/r/primitives-card.json",
    "https://www.spaceui.one/r/components-spaceui-smooth-slider.json",
    "https://www.spaceui.one/r/components-spaceui-blur-reveal-text.json",
    "https://www.spaceui.one/r/hooks-utils-format-text.json"
  ],
  "categories": ["interaction", "agents", "pipeline"],
  "meta": {
    "cycleDurationMs": 12300,
    "demoProps": {
      "animation": {
        "value": "active",
        "options": {
          "Active": "active",
          "Inactive": "inactive"
        }
      },
      "cyclePreset": {
        "value": true,
        "dependsOn": {
          "animation": "active"
        }
      },
      "preset": {
        "type": "select",
        "value": "incident",
        "options": {
          "Incident": "incident",
          "Code Review": "codereview",
          "Support": "support",
          "Growth": "growth"
        },
        "dependsOn": {
          "cyclePreset": false
        }
      },
      "cycleFlows": {
        "value": true,
        "dependsOn": {
          "animation": "active"
        }
      },
      "flow": {
        "type": "select",
        "value": "success",
        "options": {
          "Success": "success",
          "Error": "error"
        },
        "dependsOn": {
          "cycleFlows": false
        }
      },
      "autoPlay": {
        "value": true,
        "dependsOn": {
          "animation": "active"
        }
      },
      "pauseOnHover": {
        "value": true,
        "dependsOn": {
          "animation": "active"
        }
      },
      "speed": {
        "value": 1,
        "min": 0.25,
        "max": 3,
        "step": 0.25,
        "dependsOn": {
          "animation": "active"
        }
      }
    }
  },
  "files": [
    {
      "path": "src/registry/interactions/agent-pipeline/index.tsx",
      "type": "registry:component",
      "target": "components/interactions/agent-pipeline.tsx"
    },
    {
      "path": "src/registry/interactions/agent-pipeline/data.ts",
      "type": "registry:component",
      "target": "components/interactions/agent-pipeline-data.ts"
    }
  ],
  "createdAt": "2026-09-21",
  "updatedAt": "2026-09-21"
}
