{
  "name": "space-ui",
  "version": "0.0.11",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbo",
    "start": "next start",
    "build:local": "node --no-experimental-webstorage ./node_modules/next/dist/bin/next build",
    "dev:local": "node --no-experimental-webstorage ./node_modules/next/dist/bin/next dev --turbo",
    "start:local": "node --no-experimental-webstorage ./node_modules/next/dist/bin/next start",
    "postinstall": "fumadocs-mdx",
    "sync:styles": "tsx ./scripts/sync-globals-css.ts",
    "clean": "pnpm registry:clean && pnpm registry:build",
    "registry:build": "tsx ./scripts/sync-globals-css.ts && pnpm format:write && tsx ./scripts/build-registry.ts && pnpm format:write",
    "registry:clean": "tsx ./scripts/clean-registry-items.ts",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache"
  },
  "dependencies": {
