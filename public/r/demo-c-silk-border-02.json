      "path": "src/registry/demo/components/spaceui/silk-border/c-silk-border-02/index.tsx",
      "content": "'use client'\n\nimport { SilkBorder } from '@/components/spaceui/silk-border'\nimport { Button } from '@/components/spaceui/button-squircle'\nimport { Badge } from '@/components/spaceui/badge-squircle'\n\nexport default function Demo() {\n  return (\n    <div className=\"flex flex-wrap items-center justify-center gap-6 p-6\">\n      <SilkBorder preset=\"twilight\" className=\"inline-flex squircle rounded-full p-0.75\">\n        <Button variant=\"primary\">Explore Pro Silk</Button>\n      </SilkBorder>\n\n      <SilkBorder preset=\"sunset\" grain className=\"inline-flex squircle rounded-full p-0.75\">\n        <Badge size=\"sm\" variant=\"primary\" className=\"select-none\">\n          SUNSET EDITION\n        </Badge>\n      </SilkBorder>\n\n      <SilkBorder preset=\"emerald\" className=\"inline-flex squircle rounded-full p-0.75\">\n        <Badge size=\"sm\" variant=\"secondary\" className=\"select-none\">\n          SYSTEM ACTIVE\n        </Badge>\n      </SilkBorder>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "components/spaceui/silk-border-button-demo.tsx"
    }
  ],
  "categories": [
    "demo",
    "component"
  ],
